  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Simulation
  behaviourFile: {fileID: 0}
  behaviourPath: optimized-behaviour.txt
  behaviourDefinition: '# Behaviour distributions. Sample once per vehicle. Units: m/s, metres, seconds.

    [default]

    sublaneSelection=closest

    cruiseSpeedMps=truncatedNormal(8,2,2,16)

    preferredLateralPosition=beta(2,2)

    preferenceStrength=beta(2,5)

    turnSlowdownM=boundedLognormal(10,2,2,20)

    brakingDecelerationMps2=boundedLognormal(3,0.6,1,6)

    laneFlexibilityS=truncatedNormal(3,1,0,6)

    redLightPassProbability=beta(1,29)

    

    [motorcycle]

    sublaneSelection=random

    cruiseSpeedMps=truncatedNormal(4.748,2,2,17)

    preferredLateralPosition=beta(3,2)

    preferenceStrength=beta(2,3)

    turnSlowdownM=boundedLognormal(6,1.5,2,15)

    brakingDecelerationMps2=boundedLognormal(3.5,0.8,1.5,7)

    laneFlexibilityS=truncatedNormal(-0.728,1,-1,4)

    redLightPassProbability=beta(1,7)

    

    [car]

    cruiseSpeedMps=truncatedNormal(2.985,2.5,2,16)

    brakingDecelerationMps2=boundedLognormal(3,0.6,1,6)

    laneFlexibilityS=truncatedNormal(3,1,0,6)

    redLightPassProbability=beta(1,29)

    

    [bus]

    cruiseSpeedMps=truncatedNormal(6.5,1.5,2,12)

    preferredLateralPosition=beta(4,2)

    turnSlowdownM=boundedLognormal(14,3,4,30)

    brakingDecelerationMps2=boundedLognormal(2,0.4,1,4)

    laneFlexibilityS=truncatedNormal(5,1.5,1,10)

    redLightPassProbability=beta(1,99)

    

    [truck]

    cruiseSpeedMps=truncatedNormal(6.5,1.5,2,12)

    preferredLateralPosition=beta(4,2)

    turnSlowdownM=boundedLognormal(14,3,4,30)

    brakingDecelerationMps2=boundedLognormal(2,0.4,1,4)

    laneFlexibilityS=truncatedNormal(5,1.5,1,10)

    redLightPassProbability=beta(1,99)

    

    [van]

    cruiseSpeedMps=truncatedNormal(8,2,2,14)

    brakingDecelerationMps2=boundedLognormal(2.8,0.6,1,5.5)

    laneFlexibilityS=truncatedNormal(3.5,1.2,0,7)

    redLightPassProbability=beta(1,49)

